---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
---

<aside class="blog-share" aria-label="Share this article">
  <span>Share this guide</span>
  <div>
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook">f</a>
    <a href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X">𝕏</a>
    <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn">in</a>
    <a href={`https://api.whatsapp.com/send?text=${encodedTitle}%20${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp">wa</a>
    <button type="button" class="copy-link" data-copy-url={url} aria-label="Copy article link">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 15l6-6m-8.5 9.5-1 1a3.5 3.5 0 01-5-5l4-4a3.5 3.5 0 015 0m5-5 1-1a3.5 3.5 0 015 5l-4 4a3.5 3.5 0 01-5 0"/></svg>
    </button>
  </div>
</aside>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-link").forEach((button) => {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText(button.dataset.copyUrl || window.location.href);
      button.classList.add("copied");
      button.setAttribute("aria-label", "Link copied");
      setTimeout(() => button.classList.remove("copied"), 1600);
    });
  });
</script>

<style>
  .blog-share { display:flex; align-items:center; justify-content:space-between; gap:1rem; border-block:1px solid #dce8ee; padding:1.1rem 0; }
  .blog-share span { color:#38566a; font-size:.78rem; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .blog-share div { display:flex; gap:.55rem; }
  .blog-share a,.blog-share button { display:grid; width:2.35rem; height:2.35rem; place-items:center; border:1px solid #cbdde6; border-radius:50%; background:#fff; color:#005c85; font-size:.76rem; font-weight:900; transition:.2s ease; }
  .blog-share a:hover,.blog-share button:hover,.blog-share button.copied { transform:translateY(-2px); border-color:#00a1e1; background:#00a1e1; color:#fff; }
  .blog-share button { cursor:pointer; }
  .blog-share svg { width:1rem; fill:none; stroke:currentColor; stroke-linecap:round; stroke-width:2; }
  @media(max-width:520px){ .blog-share { align-items:flex-start; flex-direction:column; } }
</style>
